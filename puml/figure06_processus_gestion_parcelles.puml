@startuml
title Gestion d'une parcelle

skinparam shadowing false

start
:Saisir la description, la superficie\net la localisation GPS;
if (Nouvelle parcelle ?) then (oui)
  :Créer la parcelle\n(POST /plots);
else (non)
  :Mettre à jour la parcelle\n(PUT /plots/{id});
endif
:Affecter la parcelle à un membre;
if (Statut à modifier ?) then (oui)
  :Changer le statut\n(ACTIVE / DÉSACTIVÉE...);
else (non)
endif
:Journaliser dans l'audit;
stop
@enduml