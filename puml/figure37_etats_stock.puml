@startuml
title États de transition du stock
skinparam shadowing false

state "AVAILABLE" as available
state "RESERVED" as reserved
state "SOLD" as sold
state "DEPLETED" as depleted
state "EXPIRED" as expired
state "DAMAGED" as damaged

[*] --> available : stock créé
available --> reserved : réservation pour une vente
reserved --> sold : vente finalisée
reserved --> available : réservation annulée
sold --> depleted : quantité épuisée
available --> expired : péremption
available --> damaged : détérioration
depleted --> [*]
expired --> [*]
damaged --> [*]

@enduml