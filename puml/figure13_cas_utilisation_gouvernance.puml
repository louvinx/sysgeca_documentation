@startuml
title Cas d'utilisation du module Gouvernance

left to right direction
skinparam shadowing false
skinparam backgroundColor White
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam title {
  FontSize 16
  FontStyle bold
  FontColor #000000
}

skinparam actor {
  BackgroundColor White
  BorderColor #000000
  FontColor #000000
  FontSize 14
  FontStyle bold
}

skinparam usecase {
  BackgroundColor White
  BorderColor #000000
  FontColor #000000
  FontSize 13
}

skinparam rectangle {
  BackgroundColor White
  BorderColor #808080
  FontColor #000000
  FontSize 13
  FontStyle bold
}

skinparam arrow {
  Color #000000
  FontColor #000000
}

skinparam line {
  Color #000000
}


actor "Administrateur" as admin
actor "Gestionnaire" as manager
actor "Membre" as member

rectangle "Module Gouvernance" {
  usecase "Créer une assemblée générale" as UC1
  usecase "Planifier l'assemblée\n(ORDINARY, EXTRAORDINARY,\nBOARD_MEETING)" as UC2
  usecase "Inviter les participants" as UC3
  usecase "Enregistrer la présence\n(PRESENT / ABSENT)" as UC4
  usecase "Rédiger le procès-verbal\n(MinutesEditor - TipTap)" as UC5
  usecase "Déposer un document d'assemblée" as UC6
  usecase "Consulter les assemblées" as UC7
  usecase "Organiser des formations" as UC8
}

admin --> UC1
manager --> UC1
admin --> UC2
admin --> UC3
manager --> UC3
admin --> UC4
manager --> UC4
admin --> UC5
manager --> UC5
admin --> UC6
admin --> UC7
manager --> UC7
member --> UC7
admin --> UC8

@enduml