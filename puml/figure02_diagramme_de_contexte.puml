@startuml
title Diagramme de cas utilisation du système SYSGECA

left to right direction
skinparam shadowing false

actor "Administrateur de Coopérative" as admin
actor "Gestionnaire de Coopérative" as manager
actor "Personnel" as personnel
actor "Membre" as membre

rectangle "SYSGECA" {
  usecase "1. Inscrire un membre" as UC1
  usecase "2. Gérer les parcelles (SIG)" as UC2
  usecase "3. Traiter un prêt" as UC3
  usecase "4. Enregistrer la production" as UC4
  usecase "5. Gérer les cotisations" as UC5
  usecase "6. Organiser une assemblée générale" as UC6
  usecase "7. Gérer les stocks" as UC7
  usecase "8. Gérer les ventes" as UC8
  usecase "9. Audit du système" as UC9
  usecase "10. Envoyer un message" as UC10
}

personnel --> UC1
admin --> UC1
manager --> UC2
personnel --> UC3
membre --> UC4
personnel --> UC5
manager --> UC6
personnel --> UC7
personnel --> UC8
admin --> UC9
admin --> UC10
manager --> UC10
personnel --> UC10
membre --> UC10

@enduml