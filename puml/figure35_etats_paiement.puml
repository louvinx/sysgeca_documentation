@startuml
title États de transition du paiement
skinparam shadowing false

state "PENDING" as pending
state "PARTIAL" as partial
state "PAID" as paid
state "REJECTED" as rejected
state "CANCELLED" as cancelled

[*] --> pending : création du paiement
pending --> paid : paiement complet reçu
pending --> partial : paiement partiel enregistré
partial --> paid : solde réglé en totalité
pending --> rejected : rejet
pending --> cancelled : annulation
paid --> [*]
rejected --> [*]
cancelled --> [*]

@enduml