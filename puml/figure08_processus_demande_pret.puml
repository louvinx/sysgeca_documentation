@startuml
title Demande et traitement d'un prêt

skinparam shadowing false

start
:Membre : remplir la demande\n(montant, durée, taux);
:Statut PENDING;
:Étude de la demande\n(gestionnaire / comptable);
if (Crédit acceptable ?) then (non)
  :Rejeter le prêt (REJECTED);
  stop
else (oui)
endif
:Approuver et débourser\n(APPROVED → DISBURSED);
:Enregistrer les remboursements;
if (Prêt remboursé ?) then (non)
  :Suivre les paiements en retard;
else (oui)
endif
:Clôturer le prêt (COMPLETED);
stop
@enduml