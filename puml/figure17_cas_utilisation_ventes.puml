@startuml
title Cas d'utilisation du module Ventes

left to right direction
skinparam shadowing false
skinparam backgroundColor White
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam title {
  FontSize 16
  FontStyle bold
  FontColor #000000
}

skinparam actor {
  BackgroundColor White
  BorderColor #000000
  FontColor #000000
  FontSize 14
  FontStyle bold
}

skinparam usecase {
  BackgroundColor White
  BorderColor #000000
  FontColor #000000
  FontSize 13
}

skinparam rectangle {
  BackgroundColor White
  BorderColor #808080
  FontColor #000000
  FontSize 13
  FontStyle bold
}

skinparam arrow {
  Color #000000
  FontColor #000000
}

skinparam line {
  Color #000000
}


actor "Administrateur" as admin
actor "Gestionnaire" as manager
actor "Comptable" as accountant

rectangle "Module Ventes" {
  usecase "Créer une vente de stock" as UC1
  usecase "Consulter les ventes" as UC2
  usecase "Rechercher une vente" as UC3
  usecase "Consulter les ventes d'un stock" as UC4
  usecase "Modifier une vente" as UC5
  usecase "Supprimer une vente" as UC6
  usecase "Générer une facture\n(ExportService - invoice)" as UC7
  usecase "Enregistrer un paiement échelonné\n(Payment type SALE)" as UC8
  usecase "Créer la livraison\n(PENDING / IN_TRANSIT / DELIVERED)" as UC9
}

admin --> UC1
manager --> UC1
accountant --> UC1
admin --> UC2
manager --> UC2
admin --> UC3
manager --> UC3
admin --> UC4
manager --> UC4
admin --> UC5
manager --> UC5
admin --> UC6
accountant --> UC7
accountant --> UC8
manager --> UC9

@enduml