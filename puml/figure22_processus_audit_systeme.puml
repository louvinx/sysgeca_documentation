@startuml
title Audit du système

skinparam shadowing false

start
:Action utilisateur\n(création, modification, suppression, connexion);
:Intercepter l'action\n(middleware + filtre multi-tenant);
:Enregistrer le journal d'audit;
if (Action sensible ?) then (oui)
  :Journaliser les changements détaillés;
else (non)
endif
if (Suppression ?) then (oui)
  :Suppression douce (soft delete);
else (non)
endif
:Consulter / analyser les journaux;
stop
@enduml