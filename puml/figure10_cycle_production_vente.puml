@startuml
title Cycle production et vente

skinparam shadowing false

start
:Planifier la culture\n(calendrier agricole);
:Enregistrer la production;
:Créer le lot de traçabilité\n(lot, QR code);
:Alimenter le stock;
if (Récolte vendue ?) then (non)
  :Valoriser la production;
else (oui)
  :Créer la vente;
  :Créer la livraison;
  :Enregistrer le paiement;
  :Mettre à jour le stock;
endif
:Journaliser dans l'audit;
stop
@enduml