@startuml
title Collecte des cotisations

skinparam shadowing false

start
:Créer le plan de cotisation\n(montant, fréquence, dates);
:Exécuter le plan;
repeat
  :Vérifier le paiement du membre;
  if (Payé ?) then (non)
    :Marquer comme non payé\n+ pénalités / notification;
  else (oui)
  endif
repeat while (D'autres membres ?) is (oui)
-> (non);
:Consulter le total collecté;
stop
@enduml