@startuml
title Processus de gestion des ventes

skinparam shadowing false

start
:Ouvrir la page des ventes (SalesPage);

:Sélectionner le stock disponible\n(GET /stocks - statut AVAILABLE);

:Créer la vente (POST /sales - SalesService)\n- lot, stock, client, quantité, prix unitaire;

:Calculer le montant total automatiquement\n(total_amount = quantity_sold * unit_price\n- colonne Computed);

if (Paiement en plusieurs fois ?) then (oui)
  :Enregistrer un premier paiement échelonné\n(Payment type SALE - PENDING / PARTIAL);
else (non)
  :Enregistrer le paiement complet (PAID);
endif

:Créer la livraison associée (Delivery)\n- suivi PENDING / IN_TRANSIT / DELIVERED;

:Mettre à jour la quantité du stock\n(SOLD / DEPLETED);

:Générer la facture (POST /exports/invoice);

:Suivre les paiements restants (GET /sales/{id});

stop
@enduml