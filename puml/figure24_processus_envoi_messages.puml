@startuml
title Envoi de messages

skinparam shadowing false

start
:Rédiger le message\n(sujet, contenu, destinataires);
if (Type de message ?) then (Annonce)
  :Diffuser à tous les membres\n(ANNOUNCEMENT);
elseif (Type de message ?) then (Personnel)
  :Sélectionner le(s) destinataire(s);
else (Système)
  :Notification générée\npar le système;
endif
:Envoyer le message (POST /messages);
if (Envoi réussi ?) then (non)
  :Afficher l'erreur;
  stop
else (oui)
endif
:Le destinataire marque comme lu;
stop
@enduml