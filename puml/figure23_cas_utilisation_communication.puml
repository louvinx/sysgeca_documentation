@startuml
title Cas d'utilisation du module Communication

left to right direction
skinparam shadowing false
skinparam backgroundColor White
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam title {
  FontSize 16
  FontStyle bold
  FontColor #000000
}

skinparam actor {
  BackgroundColor White
  BorderColor #000000
  FontColor #000000
  FontSize 14
  FontStyle bold
}

skinparam usecase {
  BackgroundColor White
  BorderColor #000000
  FontColor #000000
  FontSize 13
}

skinparam rectangle {
  BackgroundColor White
  BorderColor #808080
  FontColor #000000
  FontSize 13
  FontStyle bold
}

skinparam arrow {
  Color #000000
  FontColor #000000
}

skinparam line {
  Color #000000
}


actor "Administrateur de Coopérative" as admin
actor "Gestionnaire de Coopérative" as manager
actor "Membre" as member

rectangle "Module Communication" {
  usecase "Envoyer un message personnel" as UC1
  usecase "Consulter la boîte de réception\n(GET /messages/inbox)" as UC2
  usecase "Consulter les messages envoyés" as UC3
  usecase "Publier une annonce\n(MessageType ANNOUNCEMENT)" as UC4
  usecase "Marquer un message comme lu" as UC5
  usecase "Supprimer un message" as UC6
  usecase "Consulter une conversation\n(GET /messages/conversation/{id})" as UC7
  usecase "Consulter les messages non lus\n(unread-count)" as UC8
}

admin --> UC1
manager --> UC1
member --> UC1
admin --> UC2
manager --> UC2
member --> UC2
admin --> UC3
manager --> UC3
member --> UC3
admin --> UC4
manager --> UC4
member --> UC5
member --> UC6
admin --> UC7
manager --> UC7
member --> UC7
member --> UC8

@enduml