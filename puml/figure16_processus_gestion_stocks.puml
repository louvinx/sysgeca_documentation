@startuml
title Processus de gestion des stocks

skinparam shadowing false

start
:Lier/créer le stock à partir de la production\n(POST /stocks - StockService, unique production_id);

:Configurer la quantité courante et les seuils\n(current_quantity, minimum_threshold,\nmaximum_threshold);

:Configurer l'entrepôt\n(warehouse_name, zone, stockage);

:État initial AVAILABLE;

if (Quantité sous le seuil minimum ?) then (non)
else (oui)
  :Passer à LOW et générer la notification\nSTOCK_ALERT;
endif

if (Date de péremption dépassée ?) then (oui)
  :Statut EXPIRED (- GET /stocks/expired);
else (non)
endif

:Vente du stock -> statut SOLD / DEPLETED;
:Réserve -> statut RESERVED;
:Transaction au stock -> statut DAMAGED /\nQUARANTINE / TRANSFERRED;

:Effectuer l'inventaire\n(Réel - last_inventory_check);

:Consulter les stocks bas\n(GET /stocks/low - alertes);

stop
@enduml