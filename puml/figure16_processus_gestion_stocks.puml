@startuml
title Gestion des stocks

skinparam shadowing false

start
:Créer le stock\n(quantité, seuils, entrepôt);
if (Quantité sous le seuil ?) then (non)
else (oui)
  :Alerte stock bas (LOW);
endif
if (Périmé ?) then (oui)
  :Statut EXPIRED;
else (non)
endif
if (Mouvement de stock ?) then (oui)
  :Vente / réserve / transfert\n(SOLD, RESERVED, TRANSFERRED);
else (non)
endif
:Effectuer l'inventaire;
stop
@enduml